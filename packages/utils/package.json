{
  "name": "@sketch-ui/utils",
  "version": "0.1.0",
  "description": "Shared runtime utilities — add your own as the library grows",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@sketch-ui/eslint-config": "workspace:*",
    "@sketch-ui/tsconfig": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
